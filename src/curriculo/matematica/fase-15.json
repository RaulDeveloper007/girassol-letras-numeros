        {
          "id": "mat-f15-n01-b01",
          "habilidade": "resolver um sistema linear 2x2 por substituição ou soma",
          "exemploResolvido": {
            "enunciado": "No sistema abaixo, qual é o valor de x?\n2x + y = 7\nx - y = 2",
            "passoAPasso": [
              "Da segunda equação: x = y + 2.",
              "Substitua na primeira: 2(y + 2) + y = 7 → 3y + 4 = 7 → y = 1.",
              "x = y + 2 = 3."
            ]
          },
          "geradorId": "matematica.sistema-2x2",
